server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Адрес контейнера бэкенда узнаётся в момент запроса, а не при старте:
  # фронт поднимается, даже если бэкенд ещё не запущен (тогда /api отвечает 502).
  resolver 127.0.0.11 valid=10s ipv6=off;

  # Маршруты приложения живут в адресе после # (например /#/stock), поэтому
  # серверу достаточно отдавать файлы как есть.
  location / {
    try_files $uri $uri/ =404;
    # Без сборки у файлов нет хэша в имени — просим браузер сверять их с сервером.
    add_header Cache-Control "no-cache";
  }

  # Все запросы данных уходят на Go-бэкенд. Адрес задаётся переменной API_UPSTREAM
  # в docker-compose.yml; путь передаётся без изменений, вместе с префиксом /api.
  location /api/ {
    set $backend "${API_UPSTREAM}";
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    # Для потока событий (SSE): без этого события приходят пачками.
    proxy_buffering off;
    proxy_read_timeout 1h;
  }
}
